---
import LanguageSwitch from "../shared/LanguageSwitch.astro";
import I18n from "../shared/I18n.astro";
import { translate } from "../../i18n";
export interface Props { current?: 'home' | 'cv' | 'blog' | 'projects' | 'about'; }
const { current } = Astro.props;
const links = [
  { href: '/blog', label: '文章', key: 'blog' },
  { href: '/projects', label: '项目', key: 'projects' },
  { href: '/cv', label: '履历', key: 'cv' },
  { href: '/about', label: '关于', key: 'about' },
];
---
<header class="site-nav">
  <div class="container nav-inner">
    <a href="/" class="wordmark" aria-label={translate("pusidun 首页")} data-i18n-aria-label="pusidun 首页"><span class="diamond" aria-hidden="true"></span>pusidun</a>
    <nav class="desktop-nav" aria-label={translate("主导航")} data-i18n-aria-label="主导航">
      {links.map(link => <a href={link.href} aria-current={current === link.key ? 'page' : undefined}><I18n text={link.label} /></a>)}
    </nav>
    <LanguageSwitch />
    <a class="nav-external" href="https://github.com/pusidun" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    <button class="menu-toggle" id="open-menu" aria-label={translate("打开导航菜单")} data-i18n-aria-label="打开导航菜单" aria-controls="mobile-menu" aria-expanded="false"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" style="margin:auto"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" /></svg></button>
  </div>
</header>
<dialog id="mobile-menu" class="mobile-menu" aria-label={translate("导航菜单")} data-i18n-aria-label="导航菜单">
  <header><a href="/" class="wordmark"><span class="diamond" aria-hidden="true"></span>pusidun</a><button class="menu-toggle" id="close-menu" aria-label={translate("关闭导航菜单")} data-i18n-aria-label="关闭导航菜单">✕</button></header>
  <nav aria-label={translate("移动端主导航")} data-i18n-aria-label="移动端主导航">
    <a href="/"><I18n text="首页" /></a>
    {links.map(link => <a href={link.href} aria-current={current === link.key ? 'page' : undefined}><I18n text={link.label} /></a>)}
    <a href="https://github.com/pusidun" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    <LanguageSwitch />
  </nav>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#mobile-menu');
  const open = document.querySelector<HTMLButtonElement>('#open-menu');
  open?.addEventListener('click', () => { dialog?.showModal(); open.setAttribute('aria-expanded', 'true'); });
  document.querySelector('#close-menu')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('close', () => { open?.setAttribute('aria-expanded', 'false'); open?.focus(); });
  matchMedia('(min-width: 768px)').addEventListener('change', (event) => { if (event.matches && dialog?.open) dialog.close(); });
</script>
