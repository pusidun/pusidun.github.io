<div class="language-switch">
  <span class="language-label language-label-en" aria-hidden="true">EN</span>
  <button type="button" class="language-toggle" role="switch" aria-checked="false" aria-label="Chinese / 中文" data-language-switch>
    <span class="language-track" aria-hidden="true"><span class="language-thumb"></span></span>
  </button>
  <span class="language-label language-label-zh" aria-hidden="true">中文</span>
</div>
