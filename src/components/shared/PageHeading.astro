---
import I18n from "./I18n.astro";
interface Props { eyebrow: string; title: string; description?: string; }
const { eyebrow, title, description } = Astro.props;
---
<header class="page-heading"><p class="eyebrow"><span class="diamond" aria-hidden="true"></span><I18n text={eyebrow} /></p><h1><I18n text={title} /></h1>{description && <p class="lead"><I18n text={description} /></p>}</header>
