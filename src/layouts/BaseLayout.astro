---
import { translate } from '../i18n';
import I18n from '../components/shared/I18n.astro';
import TopNav from '../components/nav/TopNav.astro';
import Footer from '../components/shared/Footer.astro';
import '../styles/global.css';


export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  current?: 'home' | 'cv' | 'blog' | 'projects' | 'about';
}

const {
  title,
  description = 'pusidun — engineer · blog · projects',
  ogImage = '/og/default.png',
  current,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      try { document.documentElement.lang = localStorage.getItem('pusidun-language') === 'zh' ? 'zh-CN' : 'en'; } catch { /* English remains the default. */ }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title data-i18n={title}>{translate(title)}</title>
    <meta name="description" content={translate(description)} data-i18n-content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={translate(title)} data-i18n-content={title} />
    <meta property="og:description" content={translate(description)} data-i18n-content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" href="https://github.com/pusidun.png?size=64" />
    <link rel="apple-touch-icon" href="https://github.com/pusidun.png?size=180" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400&family=Noto+Sans+SC:wght@400;500;600&family=Noto+Serif+SC:wght@400&display=swap"
      rel="stylesheet"
    />


  </head>
  <body>
    <a href="#main-content" class="skip-link"><I18n text="跳转到正文" /></a>
    <TopNav current={current} />
    <slot />
    <Footer />
    <script>import "../scripts/language";</script>
  </body>
</html>
