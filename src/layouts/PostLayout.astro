---
import { translate, formatDate } from "../i18n";
import I18n from "../components/shared/I18n.astro";
import BaseLayout from './BaseLayout.astro';
import '../styles/markdown.css';
export interface Props { title: string; date: Date; type: string; tags: string[]; summary?: string; prev?: { slug: string; title: string } | null; next?: { slug: string; title: string } | null; }
const { title, date, type, tags, summary, prev, next } = Astro.props;
const formattedDate = formatDate(date);
---
<BaseLayout title={`${title} · pusidun`} description={summary || title} current="blog" content>
  <main id="main-content" class="container site-main article">
    <a class="text-link" href="/blog"><I18n text="← 全部文章" /></a>
    <article>
      <header class="article-header">
        <div class="post-meta"><span class="badge"><I18n text={type} /></span><time data-localized-date datetime={date.toISOString()}>{formattedDate}</time></div>
        <h1>{title}</h1>
        <div class="tags">{tags.map(tag => <a href={`/blog?tags=${encodeURIComponent(tag)}`} class="text-link">#<I18n text={tag} content /></a>)}</div>
      </header>
      <div class="prose" lang="zh-CN"><slot /></div>
    </article>
    <nav class="article-nav" aria-label={translate("前后篇文章")} data-i18n-aria-label="前后篇文章">
      {prev && <a href={`/blog/${prev.slug}/`}><span><I18n text="← 上一篇" /></span>{prev.title}</a>}
      {next && <a href={`/blog/${next.slug}/`}><span><I18n text="下一篇 →" /></span>{next.title}</a>}
    </nav>
  </main>
</BaseLayout>
