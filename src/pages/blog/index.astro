---
import { translate } from "../../i18n";
import I18n from "../../components/shared/I18n.astro";
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/shared/PageHeading.astro';
import PostCard from '../../components/blog/PostCard.astro';
import BlogFilter from '../../components/blog/BlogFilter.svelte';
import { comparePostsForListing } from '../../utils/posts';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(comparePostsForListing);
const types = Array.from(new Set(posts.map(p => p.data.type)));
const tagCounts = new Map<string, number>();
for (const p of posts) for (const tag of p.data.tags) tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
const rankedTags = Array.from(tagCounts.entries()).sort((a,b) => b[1] - a[1] || a[0].localeCompare(b[0]));
// Tags that only ever match one post make a 20-button row that is taller than the
// results it filters. Show the shared ones; the long tail sits behind a disclosure.
const tags = rankedTags.filter(([, n]) => n >= 2).map(([tag]) => tag);
const moreTags = rankedTags.filter(([, n]) => n < 2).map(([tag]) => tag);
---
<BaseLayout title="文章 · pusidun" description="关于系统编程、终端安全与工程实践的文章和学习笔记。" current="blog">
  <main id="main-content" class="container site-main">
    <PageHeading eyebrow={`Writing / ${posts.length} 篇文章`} title="把思考写下来。" description="记录软件、系统与安全的学习笔记，以及工程实践中值得分享的细节。" />
    <BlogFilter client:load types={types} tags={tags} moreTags={moreTags} posts={posts.map(p => ({ id: p.id, title: p.data.title, summary: p.data.summary || '', type: p.data.type, tags: p.data.tags }))} />
    <section id="post-list" class="post-grid" aria-label={translate("文章列表")} data-i18n-aria-label="文章列表">
      {posts.map(p => <PostCard href={`/blog/${p.id}/`} {...p.data} />)}
      <div id="post-empty" class="empty-state" style="display:none" role="status"><h2><I18n text="没有匹配的文章" /></h2><p><I18n text="换个关键词或标签，或重置搜索与筛选。" /></p></div>
    </section>
  </main>
</BaseLayout>
