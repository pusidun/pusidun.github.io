---
import { translate } from "../../i18n";
import I18n from "../../components/shared/I18n.astro";
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/shared/PageHeading.astro';
import PostCard from '../../components/blog/PostCard.astro';
import BlogFilter from '../../components/blog/BlogFilter.svelte';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const types = Array.from(new Set(posts.map(p => p.data.type)));
const tagCounts = new Map<string, number>();
for (const p of posts) for (const tag of p.data.tags) tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
const tags = Array.from(tagCounts.entries()).sort((a,b) => b[1] - a[1]).map(([tag]) => tag);
---
<BaseLayout title="文章 · pusidun" description="关于系统编程、终端安全与工程实践的文章和学习笔记。" current="blog">
  <main id="main-content" class="container site-main">
    <PageHeading eyebrow={`Writing / ${posts.length} 篇文章`} title="思考，写下来。" description="关于软件、系统与安全的学习笔记，和工程实践中值得留下的细节。" />
    <BlogFilter client:load types={types} tags={tags} posts={posts.map(p => ({ id: p.id, title: p.data.title, summary: p.data.summary || '', body: p.body || '', type: p.data.type, tags: p.data.tags }))} />
    <section id="post-list" class="post-grid" aria-label={translate("文章列表")} data-i18n-aria-label="文章列表">
      {posts.map(p => <PostCard href={`/blog/${p.id}/`} {...p.data} />)}
      <div id="post-empty" class="empty-state" style="display:none" role="status"><h2><I18n text="没有匹配的文章" /></h2><p><I18n text="试试其他标签，或清除筛选查看全部文章。" /></p></div>
    </section>
  </main>
</BaseLayout>
