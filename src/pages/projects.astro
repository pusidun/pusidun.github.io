---
import I18n from "../components/shared/I18n.astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/shared/PageHeading.astro';
import { projects } from '../data/projects';
---
<BaseLayout title="项目 · pusidun" description="pusidun 的开源项目：C++ 基础库与 Go 即时通信系统。" current="projects">
  <main id="main-content" class="container site-main">
    <PageHeading eyebrow="Projects / 开源实践" title="把想法写成代码。" description="从基础库到应用系统，在具体的问题中探索、实现和积累。" />
    <div class="project-list">{projects.map((project, i) => <article class:list={['project-card', { 'dark-card': i === 1 }]}>
      <div class="post-meta"><span class="badge">{project.language}</span><span><I18n text={project.status} /></span></div>
      <h2>{project.name}</h2><p><I18n text={project.description} /></p><a class="text-link" href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`GitHub: ${project.name}`}><I18n text="查看源码 ↗" /></a>
    </article>)}</div>
    <div class="section"><h2><I18n text="更多代码与探索" /></h2><p class="lead"><I18n text="其他仓库与更新记录，可以在 GitHub 找到。" /></p><div class="actions"><a href="https://github.com/pusidun" class="button button-primary" target="_blank" rel="noopener noreferrer"><I18n text="访问 GitHub ↗" /></a></div></div>
  </main>
</BaseLayout>
