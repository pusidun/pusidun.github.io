---
import I18n from "../components/shared/I18n.astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/shared/PageHeading.astro';
import { projects } from '../data/projects';
import PrivatePanel from '../components/shared/PrivatePanel.astro';
---
<BaseLayout title="关于 · pusidun" description="关于 pusidun，以及联系方式、开源项目和朋友们的博客。" current="about">
  <main id="main-content" class="container site-main">
    <PageHeading eyebrow="About / 关于我" title="你好，我是 pusidun。" description="一名软件工程师。这里是我的个人博客，记录技术学习、工程实践和开源探索。" />
    <div class="about-grid">
      <section class="card" id="contact"><h2><I18n text="联系我" /></h2><PrivatePanel kind="contacts" /></section>
      <section class="card qr-card"><h2><I18n text="公众号" /></h2><p class="muted"><I18n text="也可以在微信里找到我的分享。" /></p><PrivatePanel kind="qr" /></section>
    </div>
    <section class="section cta-band-coral feature-band"><div><p class="eyebrow">Open source</p><h2><I18n text="代码里的实践" /></h2><p>{projects.map(p => p.name).join(' / ')}</p></div><div><p><I18n text="探索 C++ 基础模块与 Go 应用开发，记录开发过程中的思考。" /></p><div class="actions"><a class="button button-on-coral" href="/projects"><I18n text="查看开源项目 →" /></a></div></div></section>
    <section class="section"><h2><I18n text="朋友们的博客" /></h2><div class="friends"><a class="text-link" href="https://blog.csdn.net/qq_34863439" target="_blank" rel="noopener noreferrer">try1024 ↗</a><a class="text-link" href="https://www.caoqinping.com/" target="_blank" rel="noopener noreferrer">caoqinping ↗</a></div></section>
  </main>
</BaseLayout>
