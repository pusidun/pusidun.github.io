---
import I18n from "../components/shared/I18n.astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/shared/PageHeading.astro';
import Timeline from '../components/cv/Timeline.astro';
---
<BaseLayout title="履历 · pusidun" description="pusidun 的工作经历。" current="cv">
  <main id="main-content" class="container site-main">
    <PageHeading eyebrow="Career / 工作经历" title="一路走来的工作经历" description="在不同的团队里，持续积累软件工程的实践经验。" />
    <Timeline />
    <div class="section dark-card feature-band"><div><p class="eyebrow">Beyond the timeline</p><h2><I18n text="经历之外，还有记录。" /></h2></div><div><p><I18n text="把工作与学习中的思考整理成文章，也把一些想法留在开源项目里。" /></p><div class="actions"><a href="/blog" class="button button-dark"><I18n text="阅读文章 →" /></a><a href="/projects" class="button button-dark"><I18n text="查看项目 →" /></a></div></div></div>
  </main>
</BaseLayout>
